meta {
  name: Crea attività (admin)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/attivita
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_admin}}
}

body:json {
  {
    "nome": "Mantrailing",
    "costo_default": 25.00
  }
}

script:post-response {
  const data = res.getBody();
  if (data.id) {
    bru.setVar("attivita_id", data.id);
  }
}

docs {
  Solo admin. Il nome è univoco (senza distinzione di maiuscole): un nome già
  presente risponde 409.

  costo_default è il costo proposto quando si sceglie l'attività in un
  incontro; resta modificabile sul singolo incontro.
}
