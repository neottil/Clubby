meta {
  name: Situazione tesseramenti
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/tesseramenti
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_admin}}
}

docs {
  Solo admin. Tutti i soci, ciascuno con l'ultimo rinnovo del tesseramento:
    socio_id, nome, cognome, ultimo_rinnovo, scadenza, numero_tessera, rinnovi
  ultimo_rinnovo, scadenza e numero_tessera sono null per chi non è mai stato
  tesserato; numero_tessera è quello del tesseramento più recente.
}
