meta {
  name: Crea socio (admin)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/soci
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_admin}}
}

body:json {
  {
    "nome": "Luigi",
    "cognome": "Bianchi",
    "email": "luigi.bianchi@example.com",
    "telefono": "3331234567",
    "data_iscrizione": "2024-01-15",
    "note": "Socio creato manualmente da admin"
  }
}

script:post-response {
  const data = res.getBody();
  if (data.id) {
    bru.setVar("socio_id", data.id);
  }
}

docs {
  Solo admin. Crea un socio manualmente, senza collegarlo ad alcun account.
  L'id del socio creato viene salvato in socio_id per le richieste successive.
  
  data_iscrizione è opzionale (default: oggi).
}
