meta {
  name: Ottieni token viewer
  type: http
  seq: 2
}

post {
  url: {{keycloak_url}}/realms/{{keycloak_realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{keycloak_client_id}}
  username: viewer@clubby.local
  password: Viewer1234!
  scope: openid
}

script:post-response {
  const data = res.getBody();
  if (data.access_token) {
    bru.setVar("token_viewer", data.access_token);
  }
  if (data.refresh_token) {
    bru.setVar("refresh_token_viewer", data.refresh_token);
  }
}

docs {
  Ottieni un access token per l'utente viewer.
  Il token viene salvato automaticamente nella variabile token_viewer.
}
