meta {
  name: Accesso viewer
  type: http
  seq: 2
}

post {
  url: {{auth_url}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "luca.moretti@clubby.dev",
    "password": "clubby2026"
  }
}

script:post-response {
  const data = res.getBody();
  if (data.access_token) {
    bru.setVar("token_viewer", data.access_token);
  }
  if (data.refresh_token) {
    bru.setVar("refresh_token_viewer", data.refresh_token);
  }
}

docs {
  Accesso come utente viewer: salva token_viewer e refresh_token_viewer.

  Le credenziali sono quelle create da scripts/seed-demo-data.sh (Luca Moretti,
  socio, password DEMO_PASSWORD). Lancialo prima, altrimenti l'account non
  esiste: il seed azzera il database degli account e li ricrea.
}
