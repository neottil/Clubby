meta {
  name: Ottieni token admin
  type: http
  seq: 1
}

post {
  url: {{keycloak_url}}/realms/{{keycloak_realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{keycloak_client_id}}
  username: admin@clubby.local
  password: Admin1234!
  scope: openid
}

script:post-response {
  const data = res.getBody();
  if (data.access_token) {
    bru.setVar("token_admin", data.access_token);
  }
  if (data.refresh_token) {
    bru.setVar("refresh_token_admin", data.refresh_token);
  }
}

docs {
  Ottieni un access token per l'utente admin usando il direct grant.
  Il token viene salvato automaticamente nella variabile token_admin.
  
  Nota: direct grant (password) deve essere abilitato sul client Keycloak
  oppure usa il flusso PKCE dal browser.
}
