meta {
  name: Crea voucher (admin)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/voucher
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_admin}}
}

body:json {
  {
    "socio_id": "{{socio_id}}",
    "ricarica": 100.00
  }
}

script:post-response {
  const data = res.getBody();
  if (data.id) {
    bru.setVar("voucher_id", data.id);
  }
}

docs {
  Solo admin. Attiva il voucher prepagato di un socio (uno per socio).

  ricarica (facoltativa, > 0): credito acquistato, registrato come primo
  movimento di tipo ricarica e conteggiato in Fatturazione.

  saldo_iniziale (facoltativo, default 0): solo per importare il credito di un
  voucher già in uso prima di Clubby. Non è una ricarica e non viene fatturato.

  Salva automaticamente voucher_id per le richieste successive.
}
