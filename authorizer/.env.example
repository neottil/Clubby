# ============================================================
# Clubby Authorizer - Variabili d'ambiente
# ============================================================
# Copia questo file in authorizer/.env per lo sviluppo locale.
# In produzione le variabili sono iniettate dal container (ConfigMap + Secret).
# ============================================================

PORT=3001

# Database dedicato all'authorizer: istanza Postgres condivisa con
# l'applicazione, ma database e utente separati — qui vivono le credenziali,
# e il backend applicativo non deve potervi accedere.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clubby_auth
DB_USER=clubby_auth
DB_PASSWORD=clubby_auth

# URL pubblico di questo servizio. Finisce nel claim "iss" dei token ed è ciò
# che il backend confronta in fase di verifica (AUTH_ISSUER lato backend):
# devono coincidere esattamente, altrimenti ogni token viene rifiutato.
AUTH_ISSUER=http://localhost:3001

# Chiave privata RSA (PEM PKCS#8) con cui vengono firmati i token. Gli a capo
# possono essere scritti come "\n" letterali, su una riga sola.
# Se assente, all'avvio ne viene generata una effimera: comodo in sviluppo, ma
# a ogni riavvio i token già emessi smettono di valere e va rifatto l'accesso.
# Generarla con:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"

# Primo amministratore, creato all'avvio SOLO se non esiste ancora alcun
# utente. Dovrà sostituire la password al primo accesso.
#
# La password non viene generata dall'authorizer: la produce chi provisiona
# l'ambiente (scripts/init-local.sh in locale, il workflow Infra in cluster) e
# la mostra nel proprio riepilogo. Generarla qui la renderebbe leggibile solo
# nel log del pod, il posto peggiore in cui far comparire una credenziale.
#
# Solo email e password: l'anagrafica non appartiene a questo servizio. Se chi
# amministra è anche un socio, si censisce la sua scheda socio dal pannello e
# la si collega a questo account: il collegamento è sempre manuale.
INITIAL_ADMIN_EMAIL=admin@clubby.local
INITIAL_ADMIN_PASSWORD=CambiaSubito123

# Origini ammesse per le chiamate dal browser (il frontend).
CORS_ORIGIN=http://localhost:5173
