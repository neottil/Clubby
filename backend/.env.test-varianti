# Seconda istanza del backend per la suite delle API (spec 013), sulla 3002.
# La avvia `npm run dev:backend:test` insieme alla prima, e come la prima
# carica questo file con `--env-file` sopra a backend/.env, che resta com'è.
#
# Esiste perché modalità di ricarica e moduli si leggono dall'ambiente
# all'avvio: la modalità a tagli e i moduli spenti non si possono provare
# sull'istanza principale, che gira in "free" con i moduli accesi. Stesso
# database, stessi token: i dati di prova li crea l'istanza principale.
#
# Solo interruttori, nessuna credenziale. Per questo il file sta nel repository.

PORT=3002
RECHARGE_MODE=map
ENABLE_MODULE_TESSERAMENTO=false
ENABLE_MODULE_RICEVUTE=false
