# ============================================================
# Clubby Backend - Variabili d'ambiente
# ============================================================
# Copia questo file in .env oppure esegui
# ./scripts/init-local.sh che lo genera automaticamente.
# ============================================================

# Database applicativo (locale: corrisponde a docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clubby
DB_USER=clubby
DB_PASSWORD=clubby

# Authorizer — il servizio che emette i token (cartella authorizer/).
#
# AUTH_ISSUER è l'URL pubblico dell'authorizer, quello che compare nel claim
# "iss" dei token: deve coincidere esattamente con l'AUTH_ISSUER configurato
# sull'authorizer, altrimenti ogni token viene rifiutato.
#
# AUTH_INTERNAL_URL è l'indirizzo con cui il backend lo raggiunge davvero (in
# cluster il Service interno, in locale lo stesso URL pubblico): da lì scarica
# le chiavi pubbliche per verificare i token e inoltra le operazioni di
# amministrazione sugli utenti.
AUTH_ISSUER=http://localhost:3001
AUTH_INTERNAL_URL=http://localhost:3001

# App
TENANT=local
PORT=3000

# Versione esposta da GET /api/version (pagina Info). In pipeline è il tag
# dell'immagine deployata, iniettato nel ConfigMap dal workflow di deploy.
APP_VERSION=dev
