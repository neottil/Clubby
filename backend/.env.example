# ============================================================
# ClubManager Backend - Variabili d'ambiente locali
# ============================================================
# Copia questo file in .env e sostituisci i valori.
# Oppure esegui ./scripts/init-keycloak.sh che genera .env automaticamente.
# ============================================================

NODE_ENV=development
TENANT_ID=asd1

# --- Database locale (Postgres via Docker) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clubmanager
DB_USER=clubmanager
DB_PASSWORD=clubmanager_dev

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=clubmanager
KEYCLOAK_ADMIN_CLIENT_ID=clubmanager-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=clubmanager-backend-secret
