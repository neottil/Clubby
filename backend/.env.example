# ============================================================
# ClubManager Backend - Variabili d'ambiente locali
# ============================================================
# Copia questo file in .env e sostituisci i valori.
# Caricato automaticamente da tsx via dotenv (se installato),
# oppure passato manualmente: export $(cat .env | xargs)
# ============================================================

NODE_ENV=development
TENANT_ID=asd1

# --- Database locale (Postgres via Docker) ---
DB_LOCAL=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clubmanager
DB_USER=clubmanager
DB_PASSWORD=clubmanager_dev

# Finti ARN (non usati quando DB_LOCAL=true)
DB_CLUSTER_ARN=arn:aws:rds:eu-central-1:000000000000:cluster:local
DB_SECRET_ARN=arn:aws:secretsmanager:eu-central-1:000000000000:secret:local

# --- Cognito: LocalStack ---
# Sostituisci con i valori generati da LocalStack:
#   docker compose logs localstack | grep "User Pool ID\|Client ID"
COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX
AWS_REGION_NAME=eu-central-1

# AWS_ENDPOINT fa puntare i client AWS SDK a LocalStack invece di AWS reale
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
