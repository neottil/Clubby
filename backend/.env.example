# ============================================================
# ClubManager Backend - Variabili d'ambiente
# ============================================================
# Copia questo file in .env oppure esegui
# ./scripts/init-keycloak.sh che lo genera automaticamente.
# ============================================================

# Database (local: matches docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clubmanager
DB_USER=clubmanager
DB_PASSWORD=clubmanager

# Keycloak (local: run scripts/init-keycloak.sh first)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=clubmanager
KEYCLOAK_ADMIN_CLIENT_ID=clubmanager-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=clubmanager-backend-secret

# App
TENANT=local
PORT=3000
