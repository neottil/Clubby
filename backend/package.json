{
  "name": "clubby-backend",
  "version": "2.13.0",
  "description": "Clubby API",
  "type": "module",
  "scripts": {
    "prebuild": "node ../scripts/copia-branding.mjs backend",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "predev": "node ../scripts/copia-branding.mjs backend",
    "dev": "npx tsx --watch src/server.ts",
    "predev:test": "node ../scripts/copia-branding.mjs backend",
    "dev:test": "npx tsx --env-file=.env.test src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "jose": "^5.9.6",
    "n2words": "^6.2.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.11",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.0.0",
    "jest-mock-extended": "^4.0.0",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
