# ============================================================
# ClubManager Frontend - Variabili d'ambiente locali
# ============================================================
# Copia questo file in .env.local oppure esegui
# ./scripts/init-keycloak.sh che lo genera automaticamente.
# ============================================================

# Backend locale (npx tsx src/local/server.ts su porta 3000)
VITE_API_BASE_URL=http://localhost:3000

# Keycloak (locale: Docker Compose)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=clubmanager
VITE_KEYCLOAK_CLIENT_ID=clubmanager-spa

# Tenant
VITE_TENANT_ID=asd1
