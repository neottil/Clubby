# ============================================================
# ClubManager Frontend - Variabili d'ambiente locali
# ============================================================
# Copia questo file in .env.local e sostituisci i valori
# con quelli generati da LocalStack (visibili nei log con:
#   docker compose logs localstack | grep "User Pool ID\|Client ID"
# oppure:
#   cat $(docker volume inspect clubmanager_localstack_shared -f '{{.Mountpoint}}')/localstack.env
# )
# ============================================================

# Backend locale (tsx src/local/server.ts su porta 3000)
VITE_API_BASE_URL=http://localhost:3000

# Cognito mock (LocalStack)
# Sostituisci con i valori reali dopo aver avviato LocalStack
VITE_COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# URL base OAuth: LocalStack espone Cognito su http://localhost:4566
VITE_COGNITO_ENDPOINT=http://localhost:4566

# Tenant
VITE_TENANT_ID=asd1
