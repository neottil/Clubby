# ============================================================
# Clubby Frontend - Variabili d'ambiente locali
# ============================================================
# Copia questo file in .env.local oppure esegui
# ./scripts/init-local.sh che lo genera automaticamente.
# ============================================================

# Backend locale (npm run dev, backend/src/server.ts, porta 3000)
VITE_API_BASE_URL=http://localhost:3000

# Authorizer locale (npm run dev, authorizer/src/server.ts, porta 3001):
# registrazione, accesso e cambio password passano da qui.
VITE_AUTH_BASE_URL=http://localhost:3001

# Tenant
VITE_TENANT_NAME=La mia ASD

# Attività, costi proposti e istruttori non sono variabili d'ambiente: si
# gestiscono dal pannello Admin dell'applicazione e vivono a database. Il
# frontend li legge da /api/attivita e /api/istruttori, quindi cambiarli non
# richiede una nuova build.

# Queste variabili servono SOLO in locale: in un ambiente deployato la stessa
# configurazione arriva da /config.json, generato al deploy dalle Variables
# dell'Environment GitHub (vedi src/config.ts).

# Tema colori (tutte opzionali: se assenti restano i default sotto, allineati
# ai colori del logo in frontend/public/logo.svg).
# IMPORTANTE: il valore va tra virgolette, es. VITE_THEME_PRIMARY="#FF6B4A".
# Senza virgolette il carattere # viene interpretato come inizio di un
# commento dal parser dei file .env e la variabile risulta vuota.
# VITE_THEME_PRIMARY="#FF6B4A"
# VITE_THEME_PRIMARY_TEXT="#ffffff"
# VITE_THEME_DANGER="#dc2626"
# VITE_THEME_SUCCESS="#16a34a"
# VITE_THEME_NAV_BG="#2E2A26"
# VITE_THEME_NAV_TEXT="#F5C36B"

# Logo del club (opzionale): nome di un file in branding/ (radice del repo). Se
# assente resta il logo di default, frontend/public/logo.svg.
# VITE_LOGO_FILE=asd1.svg
