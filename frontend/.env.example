# ============================================================
# Clubby Frontend - Variabili d'ambiente locali
# ============================================================
# Copia questo file in .env.local oppure esegui
# ./scripts/init-local.sh che lo genera automaticamente.
# ============================================================

# Backend locale (npm run dev, backend/src/server.ts, porta 3000)
VITE_API_BASE_URL=http://localhost:3000

# Authorizer locale (npm run dev, authorizer/src/server.ts, porta 3001):
# registrazione, accesso e cambio password passano da qui.
VITE_AUTH_BASE_URL=http://localhost:3001

# Tenant
VITE_TENANT_NAME=La mia ASD

# Mapping attività -> costo di default (JSON), usato nel form "Nuovo incontro"
# per proporre un costo quando si seleziona un'attività (resta modificabile)
VITE_ACTIVITY_SELECT_VALUES_MAPPING={"Dog Dance":20,"Mantrailing":20,"K9 Cross Training":25,"Educazione singolo":20,"Passeggiata":25,"Piscina":25}

# Istruttori selezionabili nel form "Nuovo incontro" (lista separata da virgole).
# Il primo della lista è quello preselezionato.
# Opzionale, e lasciarla vuota è una scelta valida: se non è valorizzata il
# campo "Istruttore" non appare nel form né come colonna nella tabella
# incontri, e il Resoconto mostra un unico prospetto senza raggruppamenti —
# il caso di un'associazione con un solo istruttore.
VITE_SELECT_ISTRUTTORI_VALUES=Luca,Elisabetta,Marco

# Tema colori (tutte opzionali: se assenti restano i default sotto, allineati
# ai colori del logo in frontend/public/logo.svg).
# IMPORTANTE: il valore va tra virgolette, es. VITE_THEME_PRIMARY="#FF6B4A".
# Senza virgolette il carattere # viene interpretato come inizio di un
# commento dal parser dei file .env e la variabile risulta vuota.
# VITE_THEME_PRIMARY="#FF6B4A"
# VITE_THEME_PRIMARY_TEXT="#ffffff"
# VITE_THEME_DANGER="#dc2626"
# VITE_THEME_SUCCESS="#16a34a"
# VITE_THEME_NAV_BG="#2E2A26"
# VITE_THEME_NAV_TEXT="#F5C36B"

# Logo del tenant (opzionale, non è una variabile VITE_*: viene letta da
# scripts/apply-logo.mjs prima della build, non dal browser). Il file deve
# esistere in frontend/branding/. Se assente resta il logo di default già
# presente in frontend/public/logo.svg.
# LOGO_FILE=asd1.svg
