# ============================================================
# ClubManager Frontend - Variabili d'ambiente locali
# ============================================================
# Copia questo file in .env.local oppure esegui
# ./scripts/init-local-keycloak.sh che lo genera automaticamente.
# ============================================================

# Backend locale (npm run dev, backend/src/server.ts, porta 3000)
VITE_API_BASE_URL=http://localhost:3000

# Keycloak (locale: Docker Compose)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=clubmanager
VITE_KEYCLOAK_CLIENT_ID=clubmanager-spa

# Tenant
VITE_TENANT_NAME=La mia ASD

# Mapping attività -> costo di default (JSON), usato nel form "Nuovo incontro"
# per proporre un costo quando si seleziona un'attività (resta modificabile)
VITE_ACTIVITY_SELECT_VALUES_MAPPING={"Dog Dance":20,"Mantrailing":20,"K9 Cross Training":25,"Educazione singolo":20,"Passeggiata":25,"Piscina":25}

# Tema colori (tutte opzionali: se assenti restano i default sotto).
# IMPORTANTE: il valore va tra virgolette, es. VITE_THEME_PRIMARY="#2563eb".
# Senza virgolette il carattere # viene interpretato come inizio di un
# commento dal parser dei file .env e la variabile risulta vuota.
# VITE_THEME_PRIMARY="#2563eb"
# VITE_THEME_PRIMARY_TEXT="#ffffff"
# VITE_THEME_DANGER="#dc2626"
# VITE_THEME_SUCCESS="#16a34a"
# VITE_THEME_NAV_BG="#1a1a2e"
# VITE_THEME_NAV_TEXT="#c0c0d0"

# Logo del tenant (opzionale, non è una variabile VITE_*: viene letta da
# scripts/apply-logo.mjs prima della build, non dal browser). Il file deve
# esistere in frontend/branding/. Se assente resta il logo di default già
# presente in frontend/public/logo.svg.
# LOGO_FILE=asd1.svg
