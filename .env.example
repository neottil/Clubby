# ============================================================
# ClubManager - variabili d'ambiente locali (root del progetto)
# ============================================================
# Copia questo file in .env e inserisci i valori reali.
# Il file .env NON viene committato (è in .gitignore).
# ============================================================

# Token LocalStack per abilitare cognito-idp (piano Hobby gratuito).
# 1. Registrati su https://app.localstack.cloud/sign-up
# 2. Genera un token su https://app.localstack.cloud/workspace/auth-tokens
# 3. Incolla il token qui sotto
LOCALSTACK_AUTH_TOKEN=ls-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
