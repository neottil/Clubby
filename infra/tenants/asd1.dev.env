# ============================================================
# Configurazione tenant: ASD1 - ambiente: dev
# ============================================================
# Questo file viene usato dai workflow GitHub Actions
# tramite: env-file: infra/tenants/<tenant>.<env>.env

TENANT_ID=asd1
ENVIRONMENT=dev
AWS_REGION=eu-central-1

# Stack names
STACK_AUTH=clubmanager-auth-asd1-dev
STACK_DB=clubmanager-db-asd1-dev
STACK_BACKEND=clubmanager-backend-asd1-dev
STACK_FRONTEND=clubmanager-frontend-asd1-dev

# Dominio frontend (lascia vuoto per usare il dominio CloudFront generato)
DOMAIN_NAME=
# ARN certificato ACM in us-east-1 (richiesto solo se DOMAIN_NAME è valorizzato)
ACM_CERTIFICATE_ARN=

# Aurora
DB_MIN_ACU=0.5
DB_MAX_ACU=2
DB_NAME=clubmanager

# Cognito redirect URIs (per dev usa localhost)
FRONTEND_REDIRECT_URIS=http://localhost:5173/callback
FRONTEND_LOGOUT_URIS=http://localhost:5173/
