# ============================================================
# Configurazione tenant: ASD1 - ambiente: prod
# ============================================================

TENANT_ID=asd1
ENVIRONMENT=prod
AWS_REGION=eu-central-1

# Stack names
STACK_AUTH=clubmanager-auth-asd1-prod
STACK_DB=clubmanager-db-asd1-prod
STACK_BACKEND=clubmanager-backend-asd1-prod
STACK_FRONTEND=clubmanager-frontend-asd1-prod

# Dominio frontend
# Esempio: DOMAIN_NAME=asd1.miodominio.com
DOMAIN_NAME=
ACM_CERTIFICATE_ARN=

# Aurora
DB_MIN_ACU=0.5
DB_MAX_ACU=4
DB_NAME=clubmanager

# Cognito redirect URIs (sostituisci con l'URL reale del tenant)
# Se DOMAIN_NAME è vuoto, recupera il CloudFront domain dopo il primo deploy
# ed aggiorna questi valori
FRONTEND_REDIRECT_URIS=https://CLOUDFRONT_DOMAIN/callback
FRONTEND_LOGOUT_URIS=https://CLOUDFRONT_DOMAIN/
