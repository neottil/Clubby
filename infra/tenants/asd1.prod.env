# ============================================================
# Configurazione tenant: ASD1 - ambiente: prod
# ============================================================

TENANT_ID=asd1
ENVIRONMENT=prod
AWS_REGION=eu-central-1

# Stack names
STACK_KEYCLOAK=clubmanager-keycloak-asd1-prod
STACK_DB=clubmanager-db-asd1-prod
STACK_BACKEND=clubmanager-backend-asd1-prod
STACK_FRONTEND=clubmanager-frontend-asd1-prod

# Dominio frontend
# Esempio: DOMAIN_NAME=asd1.miodominio.com
DOMAIN_NAME=
ACM_CERTIFICATE_ARN=

# Aurora
DB_MIN_ACU=0.5
DB_MAX_ACU=4
DB_NAME=clubmanager

# Keycloak
KEYCLOAK_REALM=clubmanager
KEYCLOAK_CLIENT_ID=clubmanager-spa
KEYCLOAK_ADMIN_CLIENT_ID=clubmanager-backend
# KEYCLOAK_ADMIN_CLIENT_SECRET deve essere in GitHub Secrets
