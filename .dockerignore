# Usato solo dal build del backend (context = radice del repo, vedi
# backend/Dockerfile e build-deploy.yml). Il build del frontend usa un
# contesto/dockerignore separati (frontend/.dockerignore), non toccati da
# questo file.
frontend
node_modules
backend/node_modules
backend/src
# ...tranne le migrazioni di schema, che l'immagine deve contenere: le applica
# un Job k8s che gira su questa stessa immagine (vedi backend/Dockerfile).
!backend/src/db/migrations
backend/k8s
# Copia generata da scripts/copia-branding.mjs per lo sviluppo: nell'immagine
# la cartella arriva dalla sorgente in radice (COPY branding /app/branding),
# quindi qui sarebbe solo un duplicato nel contesto di build.
backend/branding
.git
.github
k8s
*.md
docker-compose.yml
